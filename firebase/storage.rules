rules_version = '2';
// صور الأطباق: قراءة لكل مسجّل، رفع للمدير. ملفات المرضى (PDF/صور الأنظمة): للمدير والصاحب والطبيب فقط.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    function fs(hid) { return firestore.get(/databases/(default)/documents/households/$(hid)).data; }
    function manages(hid) {
      return request.auth != null && request.auth.uid in fs(hid).members
        && fs(hid).members[request.auth.uid] in ['owner', 'doctor'];
    }

    match /dishes/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /households/{hid}/{allPaths=**} {
      allow read, delete: if isAdmin() || manages(hid);
      allow write: if (isAdmin() || manages(hid))
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/.*)');
    }
    match /{other=**} { allow read, write: if false; }
  }
}
